{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "artemestbackend/**/*.php",
      "use": "vercel-php@0.7.5"
    }
  ],
  "routes": [
    {
      "src": "/artemestbackend/(.*)\\.php",
      "dest": "/artemestbackend/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}